rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null && (
        request.auth.token.email == 'yamaan115@gmail.com' ||
        (
          !exists(/databases/$(database)/documents/blocked_users/$(request.auth.uid)) &&
          !exists(/databases/$(database)/documents/security_incidents/$(request.auth.uid))
        )
      );
    }

    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email != null &&
             (request.auth.token.email == 'yamaan115@gmail.com' || 
              request.auth.token.email == 'agvgod61@gmail.com' || 
              request.auth.token.email == 'avggod61@gmail.com' || 
              request.auth.token.email == 'admin@agvgod.in' || 
              request.auth.token.email == 'bypass-admin@agvgod.in' || 
              request.auth.token.admin == true ||
              exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))) && 
             (request.auth.token.email == 'yamaan115@gmail.com' || 
              request.auth.token.email == 'agvgod61@gmail.com' || 
              request.auth.token.email == 'avggod61@gmail.com' || 
              request.auth.token.email == 'admin@agvgod.in' || 
              request.auth.token.email == 'bypass-admin@agvgod.in' || 
              request.auth.token.email_verified == true);
    }

    function isMasterAdmin() {
      return request.auth != null && 
             (request.auth.token.email == 'yamaan115@gmail.com' || 
              request.auth.token.email == 'agvgod61@gmail.com' || 
              request.auth.token.email == 'avggod61@gmail.com' || 
              request.auth.token.email == 'admin@agvgod.in' || 
              request.auth.token.email == 'bypass-admin@agvgod.in') && 
             (request.auth.token.email == 'yamaan115@gmail.com' || 
              request.auth.token.email == 'agvgod61@gmail.com' || 
              request.auth.token.email == 'avggod61@gmail.com' || 
              request.auth.token.email == 'admin@agvgod.in' || 
              request.auth.token.email == 'bypass-admin@agvgod.in' || 
              request.auth.token.email_verified == true);
    }

    function isValidId(id) {
      return id is string && id.size() <= 256;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Helpers
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'type']) &&
             data.name is string && data.name.size() <= 1000 &&
             data.price is number && data.price >= 0 &&
             data.type is string &&
             (!('image' in data) || data.image == null || (data.image is string && data.image.size() <= 1500000)) &&
             (!('images' in data) || (data.images is list && data.images.size() <= 30)) &&
             (!('status' in data) || data.status == null || data.status is string) &&
             (!('stock' in data) || data.stock == null || data.stock is number) &&
             (!('description' in data) || data.description == null || data.description is string && data.description.size() <= 10000) &&
             (!('model' in data) || data.model == null || data.model is string) &&
             (!('weight' in data) || data.weight == null || data.weight is string) &&
             (!('videoUrl' in data) || data.videoUrl == null || (data.videoUrl is string && data.videoUrl.size() <= 1500000)) &&
             (!('pdfUrl' in data) || data.pdfUrl == null || (data.pdfUrl is string && data.pdfUrl.size() <= 1500000)) &&
             (!('features' in data) || data.features == null || data.features is list) &&
             (!('sizes' in data) || data.sizes == null || data.sizes is list) &&
             (!('createdAt' in data) || data.createdAt == null || (data.createdAt is timestamp || data.createdAt is string)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp || data.updatedAt is string));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['user_id', 'items', 'total_amount', 'shipping_info']) &&
             data.user_id is string &&
             data.items is list &&
             data.total_amount is number &&
             data.shipping_info is map;
    }

    function isValidGalleryItem(data) {
      return data.keys().hasAll(['title', 'category', 'image']) &&
             data.title is string && data.title.size() <= 200 &&
             data.category is string && data.category.size() <= 50 &&
             data.image is string && data.image.size() <= 1000 &&
             (!('type' in data) || (data.type in ['image', 'video'])) &&
             (!('createdAt' in data) || (data.createdAt is timestamp));
    }

    function isValidSettings(data) {
      return (!('siteName' in data) || (data.siteName is string && data.siteName.size() <= 100)) &&
             (!('heroTitle' in data) || (data.heroTitle is string && data.heroTitle.size() <= 200)) &&
             (!('heroSubtitle' in data) || (data.heroSubtitle is string && data.heroSubtitle.size() <= 500)) &&
             (!('heroImage' in data) || (data.heroImage is string && data.heroImage.size() <= 1500000)) &&
             (!('accentColor' in data) || (data.accentColor is string && data.accentColor.size() <= 20)) &&
             (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 100)) &&
             (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() <= 20)) &&
             (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 20)) &&
             (!('footerText' in data) || (data.footerText is string && data.footerText.size() <= 1000)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 500)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp));
    }

    function isValidGalleryConfig(data) {
      return (!('wideImage' in data) || (data.wideImage is string && data.wideImage.size() <= 1500000)) &&
             (!('squareImage1' in data) || (data.squareImage1 is string && data.squareImage1.size() <= 1500000)) &&
             (!('squareImage2' in data) || (data.squareImage2 is string && data.squareImage2.size() <= 1500000)) &&
             (!('technicalImage' in data) || (data.technicalImage is string && data.technicalImage.size() <= 1500000)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp));
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'slug']) &&
             data.name is string && data.name.size() <= 100 &&
             data.slug is string && data.slug.size() <= 100 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             (!('image' in data) || (data.image is string && data.image.size() <= 1500000)) &&
             (!('order' in data) || (data.order is number)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp));
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'addedAt', 'addedBy']) &&
             data.email is string && data.email.size() <= 200 &&
             data.addedAt is timestamp &&
             data.addedBy is string;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['productId', 'userName', 'rating', 'comment', 'createdAt']) &&
             data.productId is string && data.productId.size() <= 128 &&
             data.userName is string && data.userName.size() <= 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 5000 &&
             data.createdAt is timestamp &&
             (!('userId' in data) || data.userId is string) &&
             // IMAGE UPLOAD RESTRICTION: Only admins can upload review images
             (!('image' in data) || (isAdmin() && data.image is string && data.image.size() <= 1500000)) &&
             (!('images' in data) || (isAdmin() && data.images is list && data.images.size() <= 5));
    }

    // Products
    match /products/{productId} {
      allow get: if true;
      allow list: if resource.data.status == 'published' || isAdmin();
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow get: if isAdmin() || resource.data.user_id == 'guest' || 
                   (isSignedIn() && (resource.data.user_id == request.auth.uid || resource.data.user_email == request.auth.token.email));
      allow list: if isAdmin() || 
                   (isSignedIn() && (resource.data.user_id == request.auth.uid || resource.data.user_email == request.auth.token.email));
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Gallery
    match /gallery/{imageId} {
      allow get: if true;
      allow list: if true; // Public asset gallery
      allow write: if isAdmin();
    }

    // Admins
    match /admins/{email} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isMasterAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow get: if true;
      allow list: if true;
      allow write: if isAdmin() && isValidSettings(incoming());
    }

    // Categories
    match /categories/{categoryId} {
      allow get: if true;
      allow list: if true;
      allow write: if isAdmin() && isValidCategory(incoming());
    }

    // Site Config
    match /site_config/{docId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin() && (
        (docId == 'homepage_gallery' && isValidGalleryConfig(incoming()))
      );
    }

    // Reviews
    match /reviews/{reviewId} {
      allow get: if true;
      allow list: if true;
      allow create: if isValidId(reviewId) && isValidReview(incoming());
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Analytics
    match /analytics/{docId} {
      allow get: if docId == 'traffic' || isAdmin();
      allow list: if isAdmin();
      allow create, update: if docId == 'traffic';
    }

    // Users Collection (Cart, Wishlist, etc)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /cart/{cartId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /blocked_users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow get, list: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Security Incidents (Tripwire)
    match /security_incidents/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid && incoming().violation != null;
      allow read: if request.auth != null && request.auth.uid == uid;
      allow get, list: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Customers
    match /customers/{customerId} {
      allow read, write: if request.auth != null && request.auth.uid == customerId;
      allow get, list: if isAdmin();
    }

    // Notes
    match /notes/{noteId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && incoming().userId == request.auth.uid;
    }

    // Cart Items
    match /cart_items/{itemId} {
      allow read, update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && incoming().user_id == request.auth.uid;
    }
  }
}
