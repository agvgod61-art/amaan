rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow read access to everyone
      allow read;
      
      // Allow write access only to admins to block direct unauthorized uploads
      allow write: if request.auth != null && (
        request.auth.token.email == 'yamaan115@gmail.com' ||
        request.auth.token.email == 'avggod61@gmail.com' ||
        request.auth.token.email == 'agvgod61@gmail.com' ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email))
      );
    }
  }
}
